---
/**
 * Compteur en molettes d'odomètre.
 *
 * ⚠️ ENTIERS UNIQUEMENT. Un odomètre compte des entiers : le voir s'arrêter
 * sur « 4,6 » est un contresens mécanique, et une décimale qui tourne est
 * illisible. La note Google s'affiche donc fixe, ailleurs.
 *
 * ⚠️ Jamais sur un chiffre inventé : la valeur vient toujours de garage.json
 * ou du barème.
 */
interface Props { valeur: number; class?: string; }
const { valeur, class: classe = '' } = Astro.props;

if (!Number.isInteger(valeur)) {
  throw new Error(`Compteur : ${valeur} n'est pas un entier. Voir le commentaire du composant.`);
}
const chiffres = String(valeur).split('');
---
<span class:list={['compteur chiffres inline-flex', classe]} data-compteur aria-label={String(valeur)}>
  {chiffres.map((c) => (
    <span class="molette" aria-hidden="true">
      <span class="ruban" data-cible={c}>
        {Array.from({ length: 10 }, (_, i) => <span class="cran">{i}</span>)}
      </span>
    </span>
  ))}
</span>

<style>
  .molette {
    display: inline-block;
    height: 1em;
    overflow: hidden;
    vertical-align: baseline;
  }
  .ruban {
    display: flex;
    flex-direction: column;
    /* Position finale par défaut : sans JS, ou en mouvement réduit,
       le bon chiffre est déjà affiché. */
    transform: translateY(calc(var(--cible, 0) * -1em));
  }
  .cran {
    display: block;
    height: 1em;
    line-height: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .compteur[data-anime] .ruban {
      transition: transform 900ms steps(10, end);
    }
  }
</style>

<script>
  /**
   * Les molettes ne roulent qu'une fois, à l'entrée dans le viewport.
   * En mouvement réduit : rien ne roule, la valeur finale est déjà en place
   * par le CSS ci-dessus.
   */
  const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-compteur]').forEach((compteur) => {
    const rubans = compteur.querySelectorAll<HTMLElement>('.ruban');
    const poser = (anime: boolean) => {
      if (anime) compteur.setAttribute('data-anime', '');
      rubans.forEach((r, i) => {
        const cible = Number(r.dataset.cible ?? 0);
        // Départ décalé d'une molette à l'autre : c'est ce décalage qui fait
        // « mécanique » plutôt que « chiffre qui change ».
        setTimeout(() => r.style.setProperty('--cible', String(cible)), anime ? i * 90 : 0);
      });
    };

    if (reduit) { poser(false); return; }

    // État de départ : tout à zéro, puis on roule à l'entrée dans le viewport.
    rubans.forEach((r) => r.style.setProperty('--cible', '0'));
    const guetteur = new IntersectionObserver((entrees) => {
      if (!entrees.some((e) => e.isIntersecting)) return;
      guetteur.disconnect();
      poser(true);
    }, { threshold: 0.6 });
    guetteur.observe(compteur);
  });
</script>
