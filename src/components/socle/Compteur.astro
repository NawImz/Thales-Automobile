---
/**
 * Compteur qui monte progressivement depuis zéro.
 *
 * ⚠️ ENTIERS UNIQUEMENT — une décimale qui défile est illisible, et la note
 * Google s'affiche fixe à côté de ses étoiles.
 * ⚠️ Jamais sur un chiffre inventé : la valeur vient de garage.json.
 */
interface Props { valeur: number; class?: string; }
const { valeur, class: classe = '' } = Astro.props;

if (!Number.isInteger(valeur)) {
  throw new Error(`Compteur : ${valeur} n'est pas un entier.`);
}
---
<span class:list={['chiffres tabular-nums', classe]} data-compteur data-cible={valeur}>{valeur}</span>

<script>
  /**
   * ⚠️ La valeur finale est celle rendue par le serveur, et elle RESTE tant
   * que le compteur n'est pas atteint. On ne remet à zéro qu'au moment
   * d'animer — sinon un compteur sous le pli reste figé sur « 0 », et un
   * garage qui annonce « 0 an d'ancienneté » est pire que pas d'animation.
   * (Faute déjà commise et corrigée : elle ne doit pas revenir.)
   */
  const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-compteur]').forEach((el) => {
    const cible = Number(el.dataset.cible ?? 0);
    if (reduit || !cible) return;

    const guetteur = new IntersectionObserver((entrees) => {
      if (!entrees.some((e) => e.isIntersecting)) return;
      guetteur.disconnect();

      const duree = 900;
      let debut = 0;
      function pas(t: number) {
        if (!debut) debut = t;
        const p = Math.min(1, (t - debut) / duree);
        // Sortie en douceur : rapide au départ, ralentit sur la fin.
        const e = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(cible * e));
        if (p < 1) requestAnimationFrame(pas);
        else el.textContent = String(cible); // jamais d'arrondi faux à l'arrivée
      }
      requestAnimationFrame(pas);
    }, { threshold: 0.6 });

    guetteur.observe(el);
  });
</script>
