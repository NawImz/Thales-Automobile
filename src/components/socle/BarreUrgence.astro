---
import { garage, lienTel, lienWhatsApp, lienItineraire } from '../../lib/garage';
import Icone from '../socle/Icone.astro';

/**
 * Barre d'urgence, collante en bas, mobile uniquement.
 * C'est l'élément le plus rentable du site : une panne se règle au
 * téléphone, pas au formulaire. Toujours visible, jamais masquée.
 */
const tel = garage.telephones.principal;
const message = `Bonjour, je vous contacte depuis votre site pour ma voiture.`;
---
<nav
  class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-3 border-t border-cambouis/15 bg-tole/95 backdrop-blur lg:hidden"
  aria-label="Contact rapide"
>
  <a
    href={lienTel(tel.numero)}
    data-event="appel"
    data-contexte="barre-urgence"
    class="flex min-h-[56px] flex-col items-center justify-center gap-0.5 bg-rouge-yamaha text-white"
  >
    <Icone nom="telephone" class="size-5" />
    <span class="text-xs font-semibold">Appeler</span>
  </a>
  <a
    href={lienWhatsApp(message)}
    data-event="whatsapp"
    data-contexte="barre-urgence"
    rel="noopener"
    class="flex min-h-[56px] flex-col items-center justify-center gap-0.5 border-x border-cambouis/15 text-cambouis"
  >
    <Icone nom="message" class="size-5" />
    <span class="text-xs font-semibold">WhatsApp</span>
  </a>
  <a
    href={lienItineraire()}
    data-event="itineraire"
    data-contexte="barre-urgence"
    rel="noopener"
    class="flex min-h-[56px] flex-col items-center justify-center gap-0.5 text-cambouis"
  >
    <Icone nom="itineraire" class="size-5" />
    <span class="text-xs font-semibold">Y aller</span>
  </a>
</nav>
