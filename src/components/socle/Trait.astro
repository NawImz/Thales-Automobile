---
/**
 * Les icônes du site, dessinées à la main.
 *
 * ⚠️ Toutes au trait, épaisseur constante, aucun aplat — c'est le langage du
 * logo. Aucun kit d'icônes n'est installé, et il ne faut pas en installer :
 * une icône importée trahit immédiatement l'unité du dessin.
 *
 * `vector-effect="non-scaling-stroke"` garde l'épaisseur identique quelle que
 * soit la taille de rendu.
 */
interface Props { nom: string; class?: string; }
const { nom, class: classe = '' } = Astro.props;

const traces: Record<string, string> = {
  // — Mécanique —
  filtre: 'M9 3h6v3l1 2v10a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2V8l1-2V3Z M8 11h8',
  disque: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z M12 3v5 M21 12h-5 M12 21v-5 M3 12h5',
  courroie: 'M7 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z M17 11a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z M7 5c6 0 10 3 10 6 M7 13c6 0 10 1 10 4',
  valise: 'M3 8h18v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8Z M9 8V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3 M7 13h3 M14 13h3 M7 17h10',
  embrayage: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M12 7v10 M7.5 9.5l9 5 M16.5 9.5l-9 5',
  helice: 'M12 12c0-5 2-8 4-8s2 4-4 8Z M12 12c5 0 8 2 8 4s-4 2-8-4Z M12 12c0 5-2 8-4 8s-2-4 4-8Z M12 12c-5 0-8-2-8-4s4-2 8 4Z M12 11a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z',
  cle: 'M14.5 3a5 5 0 0 0-4.6 7L3 16.9V21h4.1l6.9-6.9a5 5 0 1 0 .5-11.1Z M16 7.5a1 1 0 1 0 0 .01Z',
  // — Interface —
  telephone: 'M4 4h4l2 5-2.5 1.5a12 12 0 0 0 6 6L15 14l5 2v4a1 1 0 0 1-1 1A17 17 0 0 1 3 5a1 1 0 0 1 1-1Z',
  whatsapp: 'M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3Z M8.5 8.5c0 3.5 3.5 7 7 7 .8 0 1.5-.7 1.5-1.5l-2-1-1 1c-1.2-.5-2.5-1.8-3-3l1-1-1-2c-.8 0-2.5.7-2.5 1.5Z',
  itineraire: 'M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z M12 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  etoile: 'M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.7l5.9-.8L12 3.5Z',
  horloge: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z M12 7v5l3.5 2',
  fleche: 'M4 12h15 M13 6l6 6-6 6',
  // — La vis six pans : le marqueur de liste du site —
  vis: 'M12 3.2l7.6 4.4v8.8L12 20.8 4.4 16.4V7.6L12 3.2Z M12 8.4l3.1 1.8v3.6L12 15.6l-3.1-1.8v-3.6L12 8.4Z',
  coche: 'M4.5 12.5l5 5 10-11',
};

const d = traces[nom];
if (!d) throw new Error(`Trait inconnu : « ${nom} ». Il faut le dessiner dans Trait.astro.`);
---
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  vector-effect="non-scaling-stroke"
  aria-hidden="true"
  class:list={['shrink-0', classe]}
><path d={d} /></svg>
