---
import { Image } from 'astro:assets';
import Trait from './Trait.astro';
import logo from '../../assets/marque/logo.png';
import { garage, a, tel, lienTel, heureEnTexte } from '../../lib/garage';
const annee = new Date().getFullYear();
---
<footer class="border-t border-gris-trait bg-encre text-blanc-atelier">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-3">
      <div>
        <!-- ⚠️ Le logo est noir sur fond clair : sur le pied sombre il faut
             l'éclaircir, sinon le mot disparaît. `invert` seul virerait le
             turquoise au rouge — on le désature d'abord, on inverse, puis on
             réinjecte la teinte de marque par `sepia`+`hue-rotate`. Le résultat
             est vérifié à l'écran, pas supposé. -->
        <Image src={logo} alt={garage.nom} width={104} height={104} loading="lazy" class="logo-pied h-12 w-auto" />
        <p class="mt-4 text-sm text-gris-trait">Auto et bateaux, {garage.anneesExperience} ans à {a.ville}.</p>
      </div>

      <div>
        <h2 class="font-mono text-xs tracking-widest text-gris-trait">ATELIER</h2>
        <address class="mt-3 not-italic text-sm">
          {a.rue}<br />{a.codePostal} {a.ville}
        </address>
        <a href={lienTel(tel.numero)} data-event="appel" data-contexte="pied"
           class="cible mt-3 inline-flex items-center gap-2 text-turquoise">
          <Trait nom="telephone" class="size-4" />
          <span class="chiffres">{tel.affiche}</span>
        </a>
      </div>

      <div>
        <h2 class="font-mono text-xs tracking-widest text-gris-trait">HORAIRES</h2>
        <dl class="mt-3 space-y-1 text-sm">
          {garage.horaires.map((h) => (
            <div class="flex justify-between gap-4">
              <dt class="capitalize">{h.nom}</dt>
              <dd class="chiffres text-gris-trait">
                {h.ouvre ? `${heureEnTexte(h.ouvre)} – ${heureEnTexte(h.ferme)}` : 'fermé'}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="mt-12 border-t border-gris-texte pt-6 text-xs text-gris-trait">
      <p>© {annee} {garage.nom}</p>
    </div>
  </div>
</footer>

<style>
  .logo-pied { filter: grayscale(1) invert(1) brightness(1.25); }
</style>
