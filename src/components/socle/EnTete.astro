---
import Trait from './Trait.astro';
import { garage, tel, lienTel } from '../../lib/garage';

/**
 * ⚠️ Le logo n'est pas encore fourni (voir TODO-CLIENT.md). En attendant, le
 * nom est composé en typographie plutôt qu'illustré par un faux logo : un
 * placeholder graphique finirait par être pris pour la charte.
 * Dès réception du fichier, il remplace ce bloc — et lui seul.
 */
const liens = [
  { href: '/tarifs', libelle: 'Tarifs' },
  { href: '/bateaux-jet-ski', libelle: 'Bateaux' },
  { href: '/#confiance', libelle: 'Le garage' },
  { href: '/#venir', libelle: 'Venir' },
];
---
<header class="relative z-40 border-b border-gris-trait bg-blanc-atelier">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href="/" class="cible group flex flex-col justify-center leading-none min-h-[44px]" aria-label={`${garage.nom} — accueil`}>
      <span class="font-display text-lg font-bold tracking-tight">THALÈS</span>
      <span class="font-mono text-[0.6rem] tracking-[0.22em] text-gris-texte">AUTOMOBILE</span>
    </a>

    <nav class="hidden lg:block" aria-label="Navigation principale">
      <ul class="flex items-center gap-8">
        {liens.map((l) => (
          <li>
            <a href={l.href} class="lien-nav cible relative py-2 text-sm font-medium">{l.libelle}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={lienTel(tel.numero)}
        data-event="appel" data-contexte="entete"
        class="hidden items-center gap-2 px-4 py-2.5 text-sm font-semibold cadre cliquet transition-colors hover:bg-encre hover:text-blanc-atelier sm:inline-flex"
      >
        <Trait nom="telephone" class="size-4" />
        <span class="chiffres whitespace-nowrap">{tel.affiche}</span>
      </a>

      <details class="menu-mobile relative lg:hidden">
        <summary
          class="flex size-11 cursor-pointer items-center justify-center cadre"
          aria-label="Ouvrir le menu"
        >
          <span class="barres" aria-hidden="true"></span>
        </summary>
        <div class="menu-panneau">
          <ul class="flex flex-col p-2">
            {liens.map((l) => (
              <li>
                <a href={l.href} class="flex min-h-[44px] items-center px-4 text-base font-medium">
                  {l.libelle}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .menu-mobile > summary::-webkit-details-marker { display: none; }

  /* Burger dessiné en CSS : trois traits, pas d'icône importée. */
  .barres, .barres::before, .barres::after {
    display: block; width: 18px; height: var(--trait);
    background: currentColor;
    transition: transform 200ms var(--ease-cliquet);
  }
  .barres::before, .barres::after { content: ''; position: relative; }
  .barres::before { top: -5.5px; }
  .barres::after { top: 4px; }
  .menu-mobile[open] .barres { background: transparent; }
  .menu-mobile[open] .barres::before { top: 0; transform: translateY(0) rotate(45deg); }
  .menu-mobile[open] .barres::after { top: -1.5px; transform: translateY(0) rotate(-45deg); }

  /* ⚠️ Un <details> FERMÉ reçoit une containment de layout du navigateur : il
     devient le bloc conteneur de ses descendants absolus, et le panneau se
     retrouve large de 44px avec son contenu débordant hors écran, invisible.
     On le retire donc du flux à la fermeture. */
  .menu-mobile:not([open]) .menu-panneau { display: none; }

  .menu-panneau {
    position: absolute; top: 100%; right: 0;
    z-index: 40; min-width: 12rem;
    background: var(--color-blanc-atelier);
    border: var(--trait) solid var(--color-gris-trait);
  }

  /* Soulignement qui se pose par paliers, origine gauche. */
  .lien-nav::after {
    content: ''; position: absolute; left: 0; bottom: 0;
    width: 100%; height: var(--trait);
    background: currentColor;
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--duree-cliquet) var(--ease-cliquet);
  }
  .lien-nav:hover::after, .lien-nav:focus-visible::after { transform: scaleX(1); }
</style>
