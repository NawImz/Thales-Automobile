---
/**
 * Jeu d'icônes maison. Aucune librairie : 15 tracés dessinés à la main,
 * tous en 24×24, trait 1,5 px, bouts et jointures ronds, currentColor.
 * La cohérence vient de la contrainte : un seul trait, une seule épaisseur.
 *
 * Rappel : les flèches, étoiles et cases ne sont dans AUCUNE des trois
 * polices du site. Elles passent forcément par ici.
 */
export type NomIcone =
  | 'telephone' | 'message' | 'itineraire' | 'fleche' | 'etoile'
  | 'voiture' | 'bateau' | 'cle' | 'disque' | 'goutte'
  | 'horloge' | 'etiquette' | 'remorquage' | 'engrenage' | 'coche';

interface Props {
  nom: NomIcone;
  class?: string;
  titre?: string;
  plein?: boolean;
}
const { nom, class: classe = 'size-6', titre, plein = false } = Astro.props;

const traces: Record<NomIcone, string> = {
  telephone:
    '<path d="M6.5 3.5h3l1.5 4-2 1.5a11.5 11.5 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17.5 17.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z"/>',
  message:
    '<path d="M3.5 20.5 5 16.6A8.2 8.2 0 1 1 8.2 19.7Z"/><path d="M8.6 9.4c0 3.3 2.7 6 6 6"/><path d="M8.6 9.4h1.8l.9 2-1 .9"/><path d="M14.6 15.4v-1.8l2-.9.9 1"/>',
  itineraire:
    '<path d="M12 21.5s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z"/><circle cx="12" cy="10.5" r="2.6"/>',
  fleche: '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  etoile:
    '<path d="m12 3.2 2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9Z"/>',
  voiture:
    '<path d="M3 16.5v-3l2-5A2 2 0 0 1 6.9 7h10.2a2 2 0 0 1 1.9 1.5l2 5v3"/><path d="M3 13.5h18"/><circle cx="7.5" cy="16.5" r="2"/><circle cx="16.5" cy="16.5" r="2"/><path d="M9.5 16.5h5"/>',
  bateau:
    '<path d="M12 2.5v4"/><rect x="8.5" y="6.5" width="7" height="6" rx="1"/><path d="M12 12.5v5"/><path d="M8 21.5c1.6 0 1.6-1.4 3.2-1.4s1.6 1.4 3.2 1.4"/><path d="M9 17.5h6l-1.4 2.6h-3.2Z"/>',
  cle:
    '<path d="M15.6 3.6a5 5 0 0 0-5.9 6.6L3.5 16.4a2 2 0 0 0 0 2.8l1.3 1.3a2 2 0 0 0 2.8 0l6.2-6.2a5 5 0 0 0 6.6-5.9l-2.9 2.9-2.8-.7-.7-2.8Z"/>',
  disque:
    '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3"/><path d="M12 3.5v3"/><path d="M12 17.5v3"/><path d="M3.5 12h3"/><path d="M17.5 12h3"/>',
  goutte:
    '<path d="M12 3.5s5.5 6.2 5.5 9.8a5.5 5.5 0 1 1-11 0C6.5 9.7 12 3.5 12 3.5Z"/>',
  horloge: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.3l3.3 2"/>',
  etiquette:
    '<path d="M11.6 3.5H20a.5.5 0 0 1 .5.5v8.4a1 1 0 0 1-.3.7l-7.6 7.6a1 1 0 0 1-1.4 0l-7.7-7.7a1 1 0 0 1 0-1.4l7.6-7.6a1 1 0 0 1 .5-.5Z"/><circle cx="16.4" cy="7.6" r="1.4"/>',
  remorquage:
    '<path d="M3 16.5v-8h9l3 3h6v5"/><circle cx="7" cy="17.5" r="2"/><circle cx="17" cy="17.5" r="2"/><path d="M9 17.5h6"/><path d="M12 8.5V4.5h5"/>',
  engrenage:
    '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v2.6M12 18.9v2.6M21.5 12h-2.6M5.1 12H2.5M18.7 5.3l-1.8 1.8M7.1 16.9l-1.8 1.8M18.7 18.7l-1.8-1.8M7.1 7.1 5.3 5.3"/>',
  coche: '<path d="m4.5 12.5 5 5 10-11"/>',
};

const decoratif = !titre;
---

<svg
  class={classe}
  viewBox="0 0 24 24"
  fill={plein ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={decoratif ? 'true' : undefined}
  role={decoratif ? undefined : 'img'}
  focusable="false"
>
  {titre && <title>{titre}</title>}
  <Fragment set:html={traces[nom]} />
</svg>
