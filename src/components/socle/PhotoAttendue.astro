---
/**
 * Emplacement de photo. Tant que Nabil n'a pas fourni les vrais clichés,
 * aucune image de banque ni générée : un bloc au bon ratio qui nomme la
 * photo attendue. La mise en page ne bouge pas quand la vraie arrive.
 */
interface Props {
  nom: string;
  ratio?: string;
  numero?: number;
  sombre?: boolean;
  class?: string;
}
const { nom, ratio = '16 / 9', numero, sombre = false, class: classe = '' } = Astro.props;
---
<div
  class:list={[
    'flex flex-col items-center justify-center gap-2 border border-dashed p-6 text-center',
    sombre ? 'border-tole/25 bg-cambouis' : 'border-beton/45 bg-tole-ombre',
    classe,
  ]}
  style={`aspect-ratio: ${ratio}`}
  role="img"
  aria-label={`Emplacement de photo à fournir : ${nom}`}
>
  <span class:list={['donnee text-xs font-semibold tracking-widest', sombre ? 'text-beton-clair' : 'text-beton']}>
    PHOTO À FOURNIR{numero ? ` · N° ${numero}` : ''}
  </span>
  <span class:list={['max-w-[38ch] text-sm', sombre ? 'text-beton-clair' : 'text-beton']}>{nom}</span>
</div>
