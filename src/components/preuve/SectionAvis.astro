---
import { garage, avisTries, avis as bloc } from '../../lib/garage';
import CarteAvis from './CarteAvis.astro';
import Icone from '../socle/Icone.astro';

const liste = avisTries();
const g = garage.avisGoogle;
const manquants = g.nombre - liste.length;
---
<section class="bg-tole" aria-labelledby="avis">
  <div class="mx-auto max-w-7xl px-5 py-section-normal sm:px-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="donnee text-xs font-semibold tracking-widest text-beton uppercase">Ce qu'en disent les clients</p>
        <h2 id="avis" class="mt-4 max-w-[20ch] font-display text-2xl font-extrabold text-bleu-port lg:text-3xl">
          Des clients qui reviennent depuis des années.
        </h2>
      </div>

      <p class="donnee flex shrink-0 items-center gap-2.5 border border-cambouis/20 px-4 py-3">
        <Icone nom="etoile" plein class="size-4 text-bleu-port" />
        <span class="text-lg font-semibold text-cambouis">{String(g.note).replace('.', ',')}</span>
        <span class="text-sm text-beton">sur {g.nombre} avis Google</span>
      </p>
    </div>

    <ul data-revele-groupe class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {liste.map((a) => <CarteAvis avis={a} />)}
    </ul>

    <p class="mt-6 text-sm text-beton">
      Extraits d'avis publiés sur Google.
      {manquants > 0 && <span> Les {manquants} autres avis sont <strong class="text-cambouis">[À COMPLÉTER]</strong> — export Google en attente.</span>}
    </p>
  </div>
</section>
