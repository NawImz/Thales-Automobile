---
import Icone from '../socle/Icone.astro';

interface Props {
  avis: {
    auteur: string;
    profil?: string | null;
    note?: number | null;
    extrait: string;
    ancienneteDite?: string | null;
    source: string;
  };
}
const { avis: a } = Astro.props;
---
<li data-revele class="flex flex-col gap-4 border border-cambouis/15 bg-tole p-6">
  {a.ancienneteDite && (
    <p class="donnee inline-flex w-fit items-center gap-1.5 border border-bleu-port/35 px-2.5 py-1 text-xs font-semibold tracking-wide text-bleu-port uppercase">
      <Icone nom="horloge" class="size-3.5" />
      {a.ancienneteDite}
    </p>
  )}

  <blockquote class="font-display text-lg leading-snug font-bold text-bleu-port normal-case">
    « {a.extrait} »
  </blockquote>

  <div class="mt-auto flex flex-wrap items-baseline gap-x-2 gap-y-1 border-t border-cambouis/12 pt-4">
    <span class="text-sm font-semibold text-cambouis">{a.auteur}</span>
    {a.profil && <span class="donnee text-xs text-beton">{a.profil}</span>}
    {a.note != null && (
      <span class="ml-auto flex items-center gap-1">
        <Icone nom="etoile" plein class="size-3.5 text-bleu-port" />
        <span class="donnee text-xs font-semibold text-cambouis">{a.note}/5</span>
      </span>
    )}
  </div>
</li>
