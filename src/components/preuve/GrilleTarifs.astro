---
import { tarifs, fourchette, fourchetteEnTexte } from '../../lib/garage';
import Icone from '../socle/Icone.astro';

/**
 * Le tableau de tarifs vissé au mur de l'atelier : libellé, points de
 * conduite, prix en mono aligné à droite. Aucune carte, aucune ombre,
 * aucun « à partir de » en gros avec le vrai prix en petit.
 *
 * C'est la section la plus rentable du site : aucun des cinq concurrents
 * n'affiche un seul prix.
 */
const lignes = tarifs.interventions
  .filter((i) => i.courant)
  .map((i) => ({
    ...i,
    prix: fourchetteEnTexte(fourchette(i.id)!),
  }));
---
<section class="bg-tole" aria-labelledby="tarifs">
  <div class="mx-auto max-w-7xl px-5 py-section-normal sm:px-8">
    <p class="donnee text-xs font-semibold tracking-widest text-beton uppercase">Ce que ça coûte</p>
    <h2 id="tarifs" class="mt-4 max-w-[22ch] font-display text-2xl font-extrabold text-bleu-port lg:text-3xl">
      Nos prix sont affichés. Personne d'autre ne le fait dans le coin.
    </h2>
    <p class="mt-5 text-lg">
      Fourchettes constatées, main-d'œuvre comprise. Le devis exact est gratuit :
      on regarde d'abord, on chiffre ensuite.
    </p>

    <ul data-revele-groupe class="mt-10 border-t border-cambouis/15">
      {lignes.map((l) => (
        <li
          data-revele
          class="flex items-baseline gap-3 border-b border-cambouis/12 py-3.5"
        >
          <span class:list={['min-w-0', l.categorie === 'nautique' ? 'text-bleu-cadran' : 'text-cambouis']}>
            {l.libelle}
          </span>
          <span class="min-w-6 flex-1 translate-y-[-0.2em] border-b border-dotted border-beton/50" aria-hidden="true"></span>
          <span class:list={[
            'donnee shrink-0 font-semibold whitespace-nowrap',
            l.categorie === 'nautique' ? 'text-bleu-cadran' : 'text-cambouis',
          ]}>
            {l.prix}
          </span>
        </li>
      ))}
    </ul>

    <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <a
        href="/tarifs"
        class="group inline-flex items-center gap-2 font-semibold text-bleu-cadran underline underline-offset-4 hover:text-bleu-port"
      >
        Voir tous les tarifs
        <Icone nom="fleche" class="size-4 transition-transform group-hover:translate-x-1" />
      </a>
      <p class="donnee border border-beton/40 px-3 py-1.5 text-xs font-semibold tracking-wide text-beton uppercase">
        À valider par Nabil avant mise en ligne
      </p>
    </div>
  </div>
</section>
