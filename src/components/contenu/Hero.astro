---
import { garage } from '../../lib/garage';
import BoutonAppel from '../conversion/BoutonAppel.astro';
import Icone from '../socle/Icone.astro';
import PhotoAttendue from '../socle/PhotoAttendue.astro';

const avis = garage.avisGoogle;
---
<section class="sur-sombre tole-nervuree relative isolate overflow-hidden bg-cambouis text-tole">
  <div class="mx-auto max-w-7xl px-5 pt-14 pb-16 sm:px-8 sm:pt-20 sm:pb-24">
    <p class="hero-suite donnee mb-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-semibold tracking-widest text-beton-clair uppercase" style="--retard: 340ms">
      <span>{garage.adresse.ville}</span>
      <span aria-hidden="true" class="text-beton">·</span>
      <span>Auto et bateaux</span>
      <span aria-hidden="true" class="text-beton">·</span>
      <span>Depuis {garage.depuis}</span>
    </p>

    <h1 class="hero-titre max-w-[17ch] font-display text-3xl font-extrabold text-tole sm:max-w-none sm:text-4xl">
      <span class="ligne"><span>On vous dit ce qu'il faut</span></span>
      <span class="ligne"><span>réparer, et ce qu'il</span></span>
      <span class="ligne"><span>ne faut pas.</span></span>
    </h1>

    <p class="hero-suite mt-7 max-w-[52ch] text-lg text-beton-clair" style="--retard: 420ms">
      {`Mécanique toutes marques et moteurs de bateau, dans le même atelier. ${garage.anneesExperience} ans de métier. Devis gratuit, prix affichés.`}
    </p>

    <div class="hero-suite mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" style="--retard: 500ms">
      <a
        href="/devis"
        data-event="estimateur"
        data-contexte="hero"
        class="group inline-flex items-center justify-center gap-2.5 rounded-[2px] bg-tole px-6 py-3.5 text-base font-semibold text-cambouis transition-colors hover:bg-white lg:bg-rouge-yamaha lg:text-white lg:hover:bg-[#a80d26]"
      >
        Estimer ma réparation
        <Icone nom="fleche" class="size-5 transition-transform group-hover:translate-x-1" />
      </a>
      <BoutonAppel
        variante="contour"
        contexte="hero"
        class="justify-center border-tole/45 text-tole hover:bg-tole hover:text-cambouis"
      />
    </div>

    <ul class="hero-suite mt-10 flex flex-wrap items-center gap-x-7 gap-y-2 border-t border-tole/15 pt-6" style="--retard: 580ms">
      <li class="flex items-center gap-1.5">
        <Icone nom="etoile" plein class="size-4 text-tole" />
        <span class="donnee text-sm font-semibold text-tole">{String(avis.note).replace('.', ',')}</span>
        <span class="text-sm text-beton-clair">sur {avis.nombre} avis Google</span>
      </li>
      <li class="text-sm text-beton-clair">Ouvert <span class="font-semibold text-tole">le samedi</span></li>
      <li class="text-sm text-beton-clair">Pièces neuves <span class="font-semibold text-tole">et d'occasion</span></li>
    </ul>
  </div>

  <PhotoAttendue
    numero={2}
    sombre
    nom="Le hangar : une voiture sur pont ET un moteur hors-bord dans le même plan. C'est la photo qui raconte tout le site."
    ratio="16 / 7"
    class="border-x-0 border-b-0"
  />
</section>

<style>
  /* Séquence d'arrivée : masques par ligne puis cascade. Total 820 ms,
     sous le budget de 900 ms. En CSS, donc sans attendre le moindre Ko
     de JavaScript — c'est la seule façon de tenir ce budget. */
  .ligne { display: block; overflow: hidden; }
  .ligne > span { display: block; }

  @media (prefers-reduced-motion: no-preference) {
    .ligne > span {
      transform: translateY(110%);
      animation: monter 560ms var(--ease-atelier) forwards;
      animation-delay: var(--retard, 0ms);
    }
    .ligne:nth-child(2) > span { --retard: 80ms; }
    .ligne:nth-child(3) > span { --retard: 160ms; }

    .hero-suite {
      opacity: 0;
      animation: apparaitre 280ms var(--ease-atelier) forwards;
      animation-delay: var(--retard, 0ms);
    }
  }

  @keyframes monter { to { transform: translateY(0); } }
  @keyframes apparaitre { to { opacity: 1; } }
</style>
