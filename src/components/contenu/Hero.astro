---
import { garage, lienTel } from '../../lib/garage';
import Icone from '../socle/Icone.astro';
import Croix from '../socle/Croix.astro';
import { VOITURE } from '../signature/traces';

/**
 * ACTE 1 — l'arrivée.
 *
 * Langage emprunté aux références client : filets de repérage, croix,
 * micro-typo monospace en HUD, display géant recouvert par l'objet.
 * Le sujet 3D est un disque de frein — la pièce que le garage change le
 * plus — et non une forme abstraite.
 */
const avis = garage.avisGoogle;
const tel = garage.telephones.principal;
const a = garage.adresse;

const affirmations = [
  'On ne change pas une pièce qui peut tenir.',
  'On appelle avant toute intervention non prévue.',
  'Une voiture et un moteur de bateau, même atelier.',
];
---
<section class="sur-sombre grille-hud relative isolate overflow-hidden bg-cambouis text-tole">
  <!-- HUD : repères et micro-typo, empruntés au plan d'atelier. -->
  <Croix class="top-[18%] left-[16.66%] -translate-x-1/2 -translate-y-1/2" />
  <Croix class="top-[64%] left-[50%] -translate-x-1/2 -translate-y-1/2" />
  <Croix class="top-[34%] left-[83.33%] -translate-x-1/2 -translate-y-1/2" />

  <p class="donnee pointer-events-none absolute top-5 right-5 hidden text-right text-[0.625rem] leading-relaxed tracking-widest text-beton uppercase sm:block sm:right-8">
    / {a.codePostal} {a.ville}<br />
    // Auto · Nautique
  </p>
  <p class="donnee pointer-events-none absolute bottom-5 left-5 hidden text-[0.625rem] leading-relaxed tracking-widest text-beton uppercase lg:block lg:left-8">
    ////// {garage.anneesExperience} ans d'atelier<br />
    Bords de Seine
  </p>

  <div class="mx-auto grid max-w-7xl gap-10 px-5 pt-14 pb-20 sm:px-8 lg:min-h-[86svh] lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-0 lg:pt-16 lg:pb-20">
    <div class="relative z-10">
      <p class="hero-suite donnee flex flex-wrap items-center gap-x-3 text-xs font-semibold tracking-widest text-beton-clair uppercase" style="--retard: 340ms">
        <span>Garage Thalès</span>
        <span aria-hidden="true" class="text-beton">—</span>
        <span>Depuis {garage.depuis}</span>
      </p>

      <h1 class="hero-titre mt-5 font-display text-4xl font-extrabold text-tole">
        <span class="ligne"><span>On vous dit</span></span>
        <span class="ligne"><span>ce qu'il faut</span></span>
        <span class="ligne"><span>réparer.</span></span>
      </h1>

      <p class="hero-suite mt-6 max-w-[34ch] text-lg text-beton-clair" style="--retard: 400ms">
        Et ce qu'il ne faut pas. Auto et moteurs de bateau, à {a.ville}.
      </p>

      <ul class="hero-suite mt-7 space-y-2" style="--retard: 440ms">
        {affirmations.map((t) => (
          <li class="flex items-start gap-3 text-base text-beton-clair">
            <Icone nom="coche" class="mt-1 size-4 text-tole/60" />
            <span>{t}</span>
          </li>
        ))}
      </ul>

      <div class="hero-suite mt-8 flex flex-col gap-3 sm:flex-row sm:items-center" style="--retard: 500ms">
        <a
          href={lienTel(tel.numero)}
          data-event="appel"
          data-contexte="hero"
          class="donnee inline-flex items-center justify-center gap-2.5 rounded-[2px] bg-tole px-6 py-4 text-lg font-semibold whitespace-nowrap text-cambouis transition-colors hover:bg-white lg:bg-rouge-yamaha lg:text-white lg:hover:bg-[#a80d26]"
        >
          <Icone nom="telephone" class="size-5" />
          {tel.affiche}
        </a>
        <a
          href="/devis"
          data-event="estimateur"
          data-contexte="hero"
          class="group inline-flex items-center justify-center gap-2.5 rounded-[2px] border border-tole/40 px-6 py-4 font-semibold text-tole transition-colors hover:bg-tole hover:text-cambouis"
        >
          Estimer ma réparation
          <Icone nom="fleche" class="size-5 transition-transform group-hover:translate-x-1" />
        </a>
      </div>

      <p class="hero-suite mt-7 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-beton-clair" style="--retard: 580ms">
        <Icone nom="etoile" plein class="size-4 text-tole" />
        <span class="donnee font-semibold text-tole">{String(avis.note).replace('.', ',')}</span>
        <span>sur {avis.nombre} avis Google</span>
        <span aria-hidden="true" class="text-beton">·</span>
        <span>Ouvert <span class="font-semibold text-tole">le samedi</span></span>
      </p>
    </div>

    <!-- L'objet : disque de frein en temps réel, ou repli au trait. -->
    <div class="relative -mx-5 aspect-square sm:-mx-8 lg:mx-0 lg:aspect-auto lg:h-[74svh]">
      <canvas
        data-scene-atelier
        class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700 data-[pret=oui]:opacity-100"
        aria-hidden="true"></canvas>

      <!-- Repli servi tant que la 3D n'est pas là, et définitif en
           mobile, en mouvement réduit ou sans WebGL. -->
      <svg
        data-repli
        viewBox="0 0 1000 320"
        class="absolute inset-0 m-auto h-auto w-full max-w-xl text-tole/45 transition-opacity duration-500"
        fill="none" aria-hidden="true"
      >
        <path d={VOITURE} stroke="currentColor" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        <circle cx="285" cy="240" r="48" stroke="currentColor" stroke-width="3" vector-effect="non-scaling-stroke" />
        <circle cx="735" cy="240" r="48" stroke="currentColor" stroke-width="3" vector-effect="non-scaling-stroke" />
      </svg>

      <p class="donnee pointer-events-none absolute right-0 bottom-0 hidden text-[0.625rem] tracking-widest text-beton uppercase lg:block">
        [ BMW M4 Compétition ]
      </p>
    </div>
  </div>
</section>



<style>
  .ligne { display: block; overflow: hidden; }
  .ligne > span { display: block; }

  /* Écrans bas : le titre cède pour que l'appel reste au-dessus du pli. */
  @media (min-width: 64rem) and (max-height: 52rem) {
    .hero-titre { font-size: clamp(2.25rem, 3.4vw, 3.25rem); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ligne > span {
      transform: translateY(110%);
      animation: monter 560ms var(--ease-atelier) forwards;
      animation-delay: var(--retard, 0ms);
    }
    .ligne:nth-child(2) > span { --retard: 80ms; }
    .ligne:nth-child(3) > span { --retard: 160ms; }

    .hero-suite {
      opacity: 0;
      animation: apparaitre 280ms var(--ease-atelier) forwards;
      animation-delay: var(--retard, 640ms);
    }
  }

  @keyframes monter { to { transform: translateY(0); } }
  @keyframes apparaitre { to { opacity: 1; } }
</style>

<script>
  import { sceneAutorisee } from '../../lib/capacites';
  /**
   * three.js n'est téléchargé que si l'appareil le porte : voir
   * `sceneAutorisee`. Sur téléphone et en mouvement réduit, les octets
   * ne partent jamais et le repli au trait reste affiché.
   */
  const toile = document.querySelector<HTMLCanvasElement>('[data-scene-atelier]');
  const repli = document.querySelector<SVGElement>('[data-repli]');

  if (toile && sceneAutorisee()) {
    const guetteur = new IntersectionObserver(async (entrees) => {
      if (!entrees.some((e) => e.isIntersecting)) return;
      guetteur.disconnect();
      try {
        const { monterScene } = await import('../signature/scene-atelier');
        await monterScene(toile, { mode: 'rotation', taille: 6 });
        repli?.style.setProperty('opacity', '0');
      } catch {
        // Échec de chargement : le repli reste, rien ne casse.
      }
    }, { rootMargin: '200px' });
    guetteur.observe(toile);
  }
</script>
