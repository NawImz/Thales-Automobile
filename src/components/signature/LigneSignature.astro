---
/**
 * L'emblème signature — voiture → disque de frein → bateau à moteur → hélice.
 *
 * ⚠️ PERFORMANCE. Première version : le chemin était recalculé et réécrit à
 * CHAQUE image de défilement. Le calcul lui-même ne coûte que ~10 µs, mais
 * `setAttribute('d')` force le navigateur à reparser le tracé et à repeindre
 * une couche fixe 60 fois par seconde — c'est ce qui faisait ramer le site.
 *
 * Désormais : 90 états sont précalculés une seule fois au chargement (8,6 ms),
 * et le défilement ne fait un `setAttribute` que lorsque l'indice change
 * VRAIMENT. On passe de ~3600 réécritures pour une page à 90 au maximum.
 */
import { FORMES, versChemin, verifierFormes, PIECES } from './formes';

verifierFormes();
const depart = FORMES.voiture.map((p) => versChemin(p.points, p.tension));
---
<div class="emblème" aria-hidden="true">
  <svg viewBox="0 0 118 88" fill="none" data-signature>
    {depart.map((d) => (
      <path
        d={d}
        stroke="currentColor" stroke-width="1.5"
        stroke-linecap="round" stroke-linejoin="round"
        vector-effect="non-scaling-stroke"
        data-piece
      />
    ))}
  </svg>
</div>

<style>
  .emblème {
    position: fixed;
    z-index: 10;
    pointer-events: none;
    color: var(--color-turquoise);
    right: 0.75rem;
    bottom: calc(56px + 0.75rem);
    width: 52px;
    opacity: 0.9;
    /* Sa propre couche de composition : le repaint ne touche pas la page. */
    will-change: transform;
    transform: translateZ(0);
  }

  @media (min-width: 64rem) { .emblème { bottom: 1.5rem; } }

  /**
   * Desktop large : l'emblème monte dans la gouttière droite.
   * ⚠️ Le seuil se CALCULE. Contenu 80rem + 2 × (96px + 16px de marge) = 96rem.
   * Réglé au jugé à 88rem, il mordait de 8 px sur le texte.
   */
  @media (min-width: 96rem) {
    .emblème {
      right: calc((100vw - 80rem) / 2 - 7rem);
      bottom: auto; top: 50%;
      transform: translateY(-50%) translateZ(0);
      width: 100px; opacity: 1;
    }
  }
</style>

<script>
  import { FORMES, precalculer, PIECES } from './formes';

  const svg = document.querySelector<SVGSVGElement>('[data-signature]');
  const pieces = svg ? [...svg.querySelectorAll<SVGPathElement>('[data-piece]')] : [];

  if (svg && pieces.length === PIECES) {
    const reduit = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // En mouvement réduit : la voiture rendue côté serveur reste. Rien ne bouge,
    // rien ne se télécharge, aucune boucle ne démarre.
    if (!reduit) {
      const etapes = [FORMES.voiture, FORMES.disque, FORMES.bateau, FORMES.helice, FORMES.voiture];
      const table = precalculer(etapes as any, 90);
      let dernier = -1;

      /** Un seul écrit DOM, et seulement quand l'état change vraiment. */
      function poser(progression: number) {
        const i = Math.min(table.length - 1, Math.max(0, Math.round(progression * (table.length - 1))));
        if (i === dernier) return;
        dernier = i;
        const chemins = table[i];
        for (let p = 0; p < pieces.length; p++) pieces[p].setAttribute('d', chemins[p]);
      }

      /**
       * ⚠️ GSAP a été RETIRÉ d'ici, et c'est le gros du gain de fluidité.
       *
       * ScrollTrigger pesait 44 Ko gzip (gsap + le plugin), téléchargés et
       * exécutés à chaque visite pour une seule chose : lire une progression
       * entre 0 et 1. Pire, son ticker tourne en PERMANENCE — page immobile
       * comprise — et il relit la géométrie du document à chaque image.
       *
       * Ici, la boucle ne démarre qu'au défilement et **s'arrête d'elle-même**
       * dès que l'inertie est retombée. Au repos, zéro ligne de JavaScript
       * s'exécute. L'inertie du `scrub: 1` est reproduite par un simple
       * lissage exponentiel.
       */
      let cible = 0;
      let lisse = 0;
      let tourne = false;

      // ⚠️ La hauteur du document est mise en cache : la relire à chaque
      // événement de défilement force un recalcul de mise en page, ce qui est
      // exactement le genre de coût qui fait ramer une page.
      let course = 0;
      function mesurer() {
        course = document.documentElement.scrollHeight - innerHeight;
      }
      mesurer();

      function boucle() {
        lisse += (cible - lisse) * 0.12;
        poser(lisse);
        if (Math.abs(cible - lisse) > 0.0004) {
          requestAnimationFrame(boucle);
        } else {
          lisse = cible;
          poser(lisse);
          tourne = false; // la boucle s'éteint
        }
      }

      function auDefilement() {
        cible = course > 0 ? Math.min(1, Math.max(0, scrollY / course)) : 0;
        if (!tourne) { tourne = true; requestAnimationFrame(boucle); }
      }

      addEventListener('scroll', auDefilement, { passive: true });
      addEventListener('resize', () => { mesurer(); auDefilement(); }, { passive: true });
      auDefilement();
    }
  }
</script>
