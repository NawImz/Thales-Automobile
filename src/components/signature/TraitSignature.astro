---
import { VOITURE } from './traces';

/**
 * L'élément signature du site : un seul trait continu qui dessine un
 * profil de voiture, puis se transforme en coque de bateau au scroll.
 *
 * C'est le métier en un geste — auto ET nautique — et c'est la charnière
 * qui introduit le pôle nautique.
 *
 * Aucune librairie : le scrub est un rAF maison de quarante lignes.
 * GSAP aurait coûté 43 Ko gzip pour interpoler soixante-deux nombres.
 */
---
<section
  data-trait
  class="sur-sombre relative bg-cambouis text-tole"
  aria-labelledby="charniere"
>
  <div class="sticky top-0 flex h-svh flex-col justify-center gap-6 overflow-hidden py-10 sm:gap-8">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
      <p class="donnee text-xs font-semibold tracking-widest text-beton-clair uppercase">
        Le même atelier
      </p>
      <h2 id="charniere" class="mt-3 font-display text-2xl font-extrabold lg:text-3xl">
        <span data-mot="roule" class="block">Ce qui roule.</span>
        <span data-mot="flotte" class="block text-beton-clair">Ce qui flotte.</span>
      </h2>
    </div>

    <div class="w-full">
      <svg
        data-scene
        viewBox="0 0 1000 320"
        class="h-auto w-full"
        fill="none"
        aria-hidden="true"
      >
        <path
          data-profil
          d={VOITURE}
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        />
        <circle data-roue cx="285" cy="240" r="48" stroke="currentColor" stroke-width="4" vector-effect="non-scaling-stroke" />
        <circle data-roue cx="735" cy="240" r="48" stroke="currentColor" stroke-width="4" vector-effect="non-scaling-stroke" />
        <!-- L'eau n'apparaît qu'une fois la coque formée. -->
        <path
          data-eau
          d="M 40 288 C 160 280 280 296 400 288 C 520 280 640 296 760 288 C 850 282 920 288 960 286"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          opacity="0"
          vector-effect="non-scaling-stroke"
        />
      </svg>
    </div>

    <p class="mx-auto w-full max-w-7xl px-5 text-lg text-beton-clair sm:px-8">
      <span data-legende>Mécanique toutes marques, freinage, distribution, embrayage.</span>
    </p>
  </div>

  <!-- Hauteur de défilement qui pilote la transformation. -->
  <div class="h-[120svh] lg:h-[150svh]" aria-hidden="true"></div>
</section>

<script>
  import { melanger } from './traces';

  const section = document.querySelector<HTMLElement>('[data-trait]');
  if (section) {
    const profil = section.querySelector<SVGPathElement>('[data-profil]')!;
    const roues = section.querySelectorAll<SVGCircleElement>('[data-roue]');
    const eau = section.querySelector<SVGPathElement>('[data-eau]')!;
    const motRoule = section.querySelector<HTMLElement>('[data-mot="roule"]')!;
    const motFlotte = section.querySelector<HTMLElement>('[data-mot="flotte"]')!;
    const legende = section.querySelector<HTMLElement>('[data-legende]')!;

    const TEXTE_AUTO = 'Mécanique toutes marques, freinage, distribution, embrayage.';
    const TEXTE_NAUTIQUE = 'Hors-bord, in-board, jet-ski. Entretien, hivernage, dépannage.';

    const reduit = matchMedia('(prefers-reduced-motion: reduce)');

    if (reduit.matches) {
      // Mouvement réduit : état final, aucune boucle, aucun scrub.
      appliquer(1);
    } else {
      let cible = 0;
      let lisse = 0;
      let anime = false;

      const mesurer = () => {
        const r = section.getBoundingClientRect();
        const course = r.height - innerHeight;
        if (course <= 0) return 0;
        return Math.min(1, Math.max(0, -r.top / course));
      };

      const boucle = () => {
        const delta = cible - lisse;
        if (Math.abs(delta) > 0.0004) {
          lisse += delta * 0.12;
          appliquer(lisse);
          requestAnimationFrame(boucle);
        } else {
          anime = false;
        }
      };

      const relancer = () => {
        cible = mesurer();
        if (!anime) {
          anime = true;
          requestAnimationFrame(boucle);
        }
      };

      addEventListener('scroll', relancer, { passive: true });
      addEventListener('resize', relancer, { passive: true });
      relancer();
      appliquer(mesurer());
    }

    function appliquer(t: number) {
      profil.setAttribute('d', melanger(t));

      // Les roues disparaissent dans la première moitié.
      const opaciteRoues = Math.max(0, 1 - t / 0.5);
      roues.forEach((r) => r.setAttribute('opacity', String(opaciteRoues)));

      // L'eau n'arrive qu'une fois la coque lisible.
      eau.setAttribute('opacity', String(Math.max(0, (t - 0.6) / 0.4) * 0.55));

      motRoule.style.color = t > 0.5 ? 'var(--color-beton-clair)' : 'var(--color-tole)';
      motFlotte.style.color = t > 0.5 ? 'var(--color-tole)' : 'var(--color-beton-clair)';
      legende.textContent = t > 0.5 ? TEXTE_NAUTIQUE : TEXTE_AUTO;
    }
  }
</script>
