---
/**
 * LA CHARNIÈRE — le volume qui roule devient celui qui flotte.
 *
 * Ce n'est plus un dessin au trait : c'est le même solide extrudé,
 * en acier, dont les 12 048 sommets se déplacent en temps réel de la
 * voiture vers la coque. Les roues s'effacent, le plan d'eau monte.
 */
---
<section data-trait class="sur-sombre grille-hud relative bg-cambouis text-tole" aria-labelledby="charniere">
  <div class="sticky top-0 flex h-svh flex-col justify-center overflow-hidden">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
      <p class="donnee text-xs font-semibold tracking-widest text-beton-clair uppercase">
        Le même atelier
      </p>
      <h2 id="charniere" class="mt-3 font-display text-2xl font-extrabold lg:text-3xl">
        <span data-mot="roule" class="block">Ce qui roule.</span>
        <span data-mot="flotte" class="block text-beton-clair">Ce qui flotte.</span>
      </h2>
    </div>

    <div class="relative mt-4 min-h-0 flex-1">
      <canvas
        data-scene-charniere
        class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700 data-[pret=oui]:opacity-100"
        aria-hidden="true"></canvas>

      <!-- Repli : servi en mobile, en mouvement réduit et sans WebGL. -->
      <div data-repli-charniere class="absolute inset-0 flex items-center justify-center px-5 transition-opacity duration-500">
        <p class="donnee max-w-[30ch] text-center text-sm leading-relaxed text-beton">
          Voiture ou moteur de bateau,<br />le même atelier et les mêmes mains.
        </p>
      </div>

      <p class="donnee pointer-events-none absolute right-5 bottom-0 hidden text-[0.625rem] tracking-widest text-beton uppercase sm:right-8 lg:block">
        [ <span data-etat>Profil auto</span> ]
      </p>
    </div>

    <p class="mx-auto mt-4 w-full max-w-7xl px-5 text-lg text-beton-clair sm:px-8">
      <span data-legende>Mécanique toutes marques, freinage, distribution, embrayage.</span>
    </p>
  </div>

  <div class="h-[130svh] lg:h-[160svh]" aria-hidden="true"></div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-trait]');
  const toile = section?.querySelector<HTMLCanvasElement>('[data-scene-charniere]');
  const repli = section?.querySelector<HTMLElement>('[data-repli-charniere]');

  if (section) {
    const motRoule = section.querySelector<HTMLElement>('[data-mot="roule"]')!;
    const motFlotte = section.querySelector<HTMLElement>('[data-mot="flotte"]')!;
    const legende = section.querySelector<HTMLElement>('[data-legende]')!;
    const etat = section.querySelector<HTMLElement>('[data-etat]')!;

    const TEXTE_AUTO = 'Mécanique toutes marques, freinage, distribution, embrayage.';
    const TEXTE_NAUTIQUE = 'Hors-bord, in-board, jet-ski. Entretien, hivernage, dépannage.';

    const reduit = matchMedia('(prefers-reduced-motion: reduce)');
    const grand = matchMedia('(min-width: 64rem)');
    const webgl = (() => {
      try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; }
    })();

    /** Progression du défilement à travers la section. */
    function mesurer() {
      const r = section.getBoundingClientRect();
      const course = r.height - innerHeight;
      return course <= 0 ? 0 : Math.min(1, Math.max(0, -r.top / course));
    }

    function habiller(t: number) {
      const versLeau = t > 0.5;
      motRoule.style.color = versLeau ? 'var(--color-beton-clair)' : 'var(--color-tole)';
      motFlotte.style.color = versLeau ? 'var(--color-tole)' : 'var(--color-beton-clair)';
      legende.textContent = versLeau ? TEXTE_NAUTIQUE : TEXTE_AUTO;
      etat.textContent = versLeau ? 'Profil coque' : 'Profil auto';
    }
    habiller(0);

    if (toile && webgl && grand.matches && !reduit.matches) {
      const guetteur = new IntersectionObserver(async (entrees) => {
        if (!entrees.some((e) => e.isIntersecting)) return;
        guetteur.disconnect();
        try {
          const { monterScene } = await import('./scene-atelier');
          const api = await monterScene(toile, { mode: 'scrub' });
          repli?.style.setProperty('opacity', '0');

          let anime = false;
          const relancer = () => {
            const t = mesurer();
            api.setMelange(t);
            habiller(t);
            if (!anime) {
              anime = true;
              // La scène lisse elle-même : on se contente de la nourrir.
              requestAnimationFrame(() => { anime = false; });
            }
          };
          addEventListener('scroll', relancer, { passive: true });
          addEventListener('resize', relancer, { passive: true });
          relancer();
        } catch {
          // Échec de chargement : le repli textuel reste, rien ne casse.
        }
      }, { rootMargin: '300px' });
      guetteur.observe(toile);
    } else if (!reduit.matches) {
      // Sans 3D, le texte bascule quand même au défilement.
      addEventListener('scroll', () => habiller(mesurer()), { passive: true });
    }
  }
</script>
