---
/**
 * Le décor animé : une route qui serpente, des voitures qui la parcourent,
 * des outils qui flottent, un garagiste qui traverse.
 *
 * ⚠️ TOUT EST EN `transform` ET `opacity`, EXCLUSIVEMENT.
 * Ce sont les deux seules propriétés que le navigateur anime sur le GPU sans
 * repasser par la mise en page ni par la peinture. Le site ramait justement
 * parce qu'un élément fixe se repeignait à chaque image : on ne recommence pas.
 * Aucune de ces animations n'exécute la moindre ligne de JavaScript.
 *
 * ⚠️ Le décor est PUREMENT décoratif : `aria-hidden`, `pointer-events: none`,
 * et il ne porte aucune information absente du texte.
 */
---
<div class="decor" aria-hidden="true">
  <!-- Deux routes, une par gouttière. Elles serpentent en sens inverse. -->
  <svg class="route route-gauche" viewBox="0 0 400 1600" preserveAspectRatio="xMidYMin slice" fill="none">
    <path
      M90 -60 C90 60 250 110 245 230 C240 350 80 390 95 520 C110 650 260 680 250 810 C240 940 85 980 100 1120 C115 1260 250 1300 240 1440 C232 1560 150 1600 155 1700"
      stroke="currentColor" stroke-width="26" stroke-linecap="round" class="asphalte"
    />
    <path
      M90 -60 C90 60 250 110 245 230 C240 350 80 390 95 520 C110 650 260 680 250 810 C240 940 85 980 100 1120 C115 1260 250 1300 240 1440 C232 1560 150 1600 155 1700"
      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      stroke-dasharray="14 18" class="bande"
    />
  </svg>

  <svg class="route route-droite" viewBox="0 0 400 1600" preserveAspectRatio="xMidYMin slice" fill="none">
    <path
      id="tracé-route"
      d="M300 -60 C300 160 120 240 140 470 C160 700 340 760 320 1010 C300 1260 130 1300 150 1540 L155 1700"
      stroke="currentColor" stroke-width="26" stroke-linecap="round" class="asphalte"
    />
    <path
      d="M300 -60 C300 160 120 240 140 470 C160 700 340 760 320 1010 C300 1260 130 1300 150 1540 L155 1700"
      stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      stroke-dasharray="14 18" class="bande"
    />
  </svg>

  <!-- Les voitures : trois, de couleurs et d'allures différentes. -->
  {[
    { classe: 'v1', couleur: 'var(--color-turquoise)' },
    { classe: 'v2', couleur: 'var(--color-encre)' },
    { classe: 'v3', couleur: 'var(--color-gris-texte)' },
    { classe: 'v4', couleur: 'var(--color-encre)' },
    { classe: 'v5', couleur: 'var(--color-turquoise)' },
  ].map((v) => (
    <svg class:list={['voiture', v.classe]} viewBox="0 0 40 20" fill="none" style={`color:${v.couleur}`}>
      <path d="M2 14 L3 9 L10 8 L14 4 L25 4 L29 8 L37 10 L38 14 Z"
            stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
      <circle cx="11" cy="15" r="3" stroke="currentColor" stroke-width="1.4" />
      <circle cx="30" cy="15" r="3" stroke="currentColor" stroke-width="1.4" />
    </svg>
  ))}

  <!-- Le garagiste, sa caisse à outils à la main. -->
  <svg class="garagiste" viewBox="0 0 30 46" fill="none">
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="14" cy="6" r="4" />
      <path d="M14 10v13 M14 13h-6 M14 13h6 M14 23l-4 10 M14 23l4 10" class="jambes" />
      <rect x="17" y="16" width="9" height="7" rx="1" class="caisse" />
    </g>
  </svg>
</div>

<style>
  .decor {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* Sa propre couche : rien de ce qui bouge ici ne repeint le contenu. */
    contain: strict;
  }

  /* ── La route ──────────────────────────────────────────────────────── */
  /**
   * ⚠️ Les deux routes ne sont PAS symétriques, et c'est délibéré.
   * Deux tracés en miroir donnent une page qui se lit comme une grille : l'œil
   * repère l'axe et tout paraît rigide. Elles ont donc des courbes, des
   * largeurs, des hauteurs et des opacités différentes, et ne se croisent
   * jamais à la même hauteur.
   */
  .route { position: absolute; color: var(--color-gris-trait); }
  .route-droite { right: -7vw;  top: -6vh;  width: 23vw; height: 230vh; opacity: 0.34; }
  /* ⚠️ Décalage vertical FRANC : à quelques pour cent près, l'œil apparie les
     deux routes et la page redevient une grille. Un tiers d'écran d'écart, et
     des inflexions deux fois plus courtes à gauche, suffisent à casser
     l'appariement. */
  .route-gauche { left: -11vw;  top: 34vh;  width: 31vw; height: 175vh; opacity: 0.2; }
  .asphalte { opacity: 0.25; }
  .bande { opacity: 0.85; }

  /* ── Les voitures ──────────────────────────────────────────────────── */
  /**
   * ⚠️ Elles descendent LA ROUTE, elles ne traversent pas l'écran.
   * Première version : un balayage de -92vw, qui faisait passer une voiture
   * en plein milieu du titre. Le décor ne doit jamais croiser le texte —
   * il vit dans la gouttière, comme l'emblème.
   *
   * Le déplacement est vertical, avec un léger balancement horizontal qui
   * suit la courbe de la route. `translate3d` uniquement : composé par le GPU,
   * aucun recalcul de mise en page.
   */
  /**
   * ⚠️ Le corridor se CALCULE, comme pour l'emblème.
   * Le contenu fait 80rem centré ; la gouttière vaut donc (100vw − 80rem)/2.
   * Une voiture de 44 px avec ±19 px de balancement demande ~80 px de
   * gouttière, soit une fenêtre d'au moins 90rem. En dessous, elle est
   * masquée — mesuré : à 1600 px une voiture mordait encore de 24 px sur le
   * texte avec des valeurs choisies au jugé.
   */
  .voiture {
    position: absolute;
    /* ⚠️ Sa propre couche : sans ça, animer une voiture force le compositeur
       à repeindre toute la couche fixe, décor et route compris. */
    will-change: transform, opacity;
    backface-visibility: hidden;
    width: 44px;
    right: 1.5vw;
    top: -80px;
    opacity: 0;
    display: none;
  }
  @media (min-width: 90rem) { .voiture { display: block; } }

  /**
   * ⚠️ Une voiture passe RAREMENT.
   * Le passage lui-même dure ~14 s, mais le cycle en dure 55 à 95 : la voiture
   * est invisible la plus grande partie du temps. C'est ce qui fait la
   * différence entre « il passe une voiture de temps en temps » et « il y a
   * un défilé permanent sur le côté ».
   *
   * Les durées sont premières entre elles pour que les passages ne se
   * resynchronisent pas : deux voitures côte à côte au même instant, ça se
   * remarque immédiatement.
   */
  .v1 { right: 1.5vw; animation: descendre 61s linear infinite;  animation-delay: 4s; }
  .v2 { right: 4.5vw; animation: descendre 79s linear infinite;  animation-delay: 26s; }
  .v3 { right: 0.4vw; animation: descendre 67s linear infinite;  animation-delay: 48s; width: 36px; }
  .v4 { right: auto; left: 2vw;   animation: descendre 71s linear infinite; animation-delay: 15s; }
  .v5 { right: auto; left: 5.5vw; animation: descendre 89s linear infinite; animation-delay: 37s; width: 38px; }

  @keyframes descendre {
    0%    { transform: translate3d(0, 0, 0) rotate(4deg);         opacity: 0; }
    1.5%  {                                                        opacity: 0.5; }
    5%    { transform: translate3d(-1.1vw, 30vh, 0) rotate(-5deg); }
    9%    { transform: translate3d(0.4vw, 62vh, 0) rotate(6deg); }
    13%   { transform: translate3d(-0.8vw, 92vh, 0) rotate(-3deg); opacity: 0.5; }
    15%   { transform: translate3d(0, 112vh, 0) rotate(0deg);      opacity: 0; }
    100%  { transform: translate3d(0, 112vh, 0) rotate(0deg);      opacity: 0; }
  }

  /* ── Le garagiste ──────────────────────────────────────────────────── */
  .garagiste {
    position: absolute;
    will-change: transform, opacity;
    backface-visibility: hidden;
    left: -34px; bottom: 14vh;
    width: 34px;
    color: var(--color-gris-texte);
    opacity: 0;
    animation: marcher 83s linear infinite;
  }
  .garagiste .jambes { animation: pas 0.7s steps(2, end) infinite alternate; transform-origin: 14px 23px; }

  /* Il traverse la marge gauche seulement — jamais la colonne de texte. */
  /* Il traverse la marge gauche seulement — jamais la colonne de texte. */
  @keyframes marcher {
    0%    { transform: translate3d(0, 0, 0);   opacity: 0; }
    2%    { opacity: 0.4; }
    16%   { opacity: 0.4; }
    19%   { transform: translate3d(7vw, 0, 0); opacity: 0; }
    100%  { transform: translate3d(7vw, 0, 0); opacity: 0; }
  }
  @keyframes pas {
    from { transform: skewX(-7deg); }
    to   { transform: skewX(7deg); }
  }

  /* ── Sous 64rem : pas de décor latéral, il n'y a pas de marge pour lui ── */
  @media (max-width: 63.99rem) {
    .garagiste { display: none; }
    .route { width: 40vw; right: -18vw; opacity: 0.16; }

  }

  /**
   * ⚠️ Mouvement réduit : pas de version « ralentie », une version SANS
   * mouvement. Le décor mobile disparaît entièrement, la route reste comme
   * une texture fixe.
   */
  @media (prefers-reduced-motion: reduce) {
    .voiture, .garagiste { display: none; }
    .route { animation: none; }
  }
</style>
