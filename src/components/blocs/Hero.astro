---
import Trait from '../socle/Trait.astro';
import Etoiles from '../socle/Etoiles.astro';
import Bouton from '../socle/Bouton.astro';
import { Picture } from 'astro:assets';
import facade from '../../assets/photos/facade-portail-bleu.webp';
import { garage, a, tel, lienTel, statutOuverture } from '../../lib/garage';

const statut = statutOuverture();
const ouvertSamedi = garage.horaires.find((h) => h.jour === 6)?.ouvre != null;
---
<section class="relative isolate overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 pt-10 pb-16 sm:px-8 lg:grid lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-16 lg:pt-16 lg:pb-24">
    <div class="rideau">
      <p class="hero-suite font-mono text-xs tracking-widest text-gris-texte uppercase" style="--retard:60ms">
        Garage Thalès — {a.ville} — depuis {garage.depuis}
      </p>

      <h1 class="mt-5 text-[length:var(--text-hero)] font-extrabold">
        <span class="ligne"><span>On vous dit</span></span>
        <span class="ligne"><span>ce qu'il faut</span></span>
        <span class="ligne"><span>réparer.</span></span>
      </h1>

      <p class="hero-suite mt-6 text-lg text-gris-texte" style="--retard:340ms">
        Et ce qu'il ne faut pas. {garage.anneesExperience} ans d'atelier à {a.ville},
        pour les voitures <span class="text-encre">et</span> les bateaux.
      </p>

      <div class="hero-suite mt-8 flex flex-col gap-3 sm:flex-row" style="--retard:400ms">
        <Bouton href="/#venir" variante="accent-desktop" class="inline-flex" data-event="devis" data-contexte="hero">
          Nous contacter
          <Trait nom="fleche" class="size-4" />
        </Bouton>
        <Bouton href={lienTel(tel.numero)} class="inline-flex" data-event="appel" data-contexte="hero">
          <Trait nom="telephone" class="size-4" />
          <span class="chiffres whitespace-nowrap">{tel.affiche}</span>
        </Bouton>
      </div>

      <!-- Bande de preuve. La note est attribuée à Google et n'est PAS balisée
           en aggregateRating : on ne balise pas des avis qu'on n'a pas collectés. -->
      <p class="hero-suite mt-7 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gris-texte" style="--retard:450ms">
        <span class="inline-flex items-center gap-2">
          <Etoiles note={garage.avisGoogle.note} />
          <strong class="chiffres text-encre">{garage.avisGoogle.note.toString().replace('.', ',')}</strong>
        </span>
        <span aria-hidden="true">·</span>
        <span><span class="chiffres">{garage.avisGoogle.nombre}</span> avis Google</span>
        {ouvertSamedi && (<><span aria-hidden="true">·</span><span>Ouvert <strong class="text-encre">le samedi</strong></span></>)}
        <span aria-hidden="true">·</span>
        <!-- Le statut est une information, jamais une action : il ne prend pas l'accent. -->
        <span class:list={[statut.ouvert ? 'font-semibold text-encre' : 'text-gris-texte']}>{statut.texte}</span>
      </p>
    </div>

    <div class="hero-suite mt-12 lg:mt-0" style="--retard:200ms">
      {/* ⚠️ PROVISOIRE : c'est la façade, pas le cliché prévu par le brief
          (le hangar avec une voiture sur pont ET un hors-bord dans le même
          cadre). Elle tient la place pour que la mise en page soit jugeable.
          À remplacer — consigné dans TODO-CLIENT.md. */}
      <Picture
        src={facade}
        alt="La devanture du garage Thalès, rue du Port à Épinay-sur-Seine, reconnaissable à son portail bleu."
        widths={[420, 720, 1080]}
        sizes="(min-width: 64rem) 46vw, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        quality={72}
        loading="eager"
        fetchpriority="high"
        class="cadre w-full object-cover"
        style="aspect-ratio: 4 / 3"
      />
    </div>
  </div>
</section>

<style>
  .ligne { display: block; overflow: hidden; }
  .ligne > span { display: block; }

  /**
   * ⚠️ L'ENTRÉE A ÉTÉ REFAITE. Deux causes de saccade, cumulées :
   *
   * 1. `clip-path` n'est PAS composé par le GPU. L'animer forçait le
   *    navigateur à repeindre tout le hero — photo de 126 Ko comprise — à
   *    chaque palier. C'est la cause principale.
   * 2. `steps()` produit un mouvement haché PAR CONSTRUCTION. C'était voulu
   *    (le « cliquet »), mais à l'arrivée sur la page ça se lit comme un bug,
   *    pas comme une intention.
   *
   * Désormais : `opacity` et `translateY` uniquement, en courbe lisse. Ce sont
   * les deux seules propriétés que le navigateur anime sans repeindre.
   */
  @media (prefers-reduced-motion: no-preference) {
    .ligne > span {
      transform: translateY(105%);
      animation: monter 620ms cubic-bezier(.22, .61, .36, 1) forwards;
      animation-delay: var(--retard, 60ms);
      will-change: transform;
    }
    .ligne:nth-child(1) > span { --retard: 60ms; }
    .ligne:nth-child(2) > span { --retard: 150ms; }
    .ligne:nth-child(3) > span { --retard: 240ms; }

    .hero-suite {
      opacity: 0;
      transform: translateY(10px);
      animation: apparaitre 520ms cubic-bezier(.22, .61, .36, 1) forwards;
      animation-delay: var(--retard, 340ms);
      will-change: transform, opacity;
    }
  }

  /* Une fois posées, les couches sont libérées : `will-change` permanent
     garde une couche vivante pour rien. */
  .ligne > span,
  .hero-suite { animation-fill-mode: forwards; }

  @keyframes monter     { to { transform: translateY(0); } }
  @keyframes apparaitre { to { opacity: 1; transform: translateY(0); } }
</style>
