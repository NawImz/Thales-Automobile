---
import Trait from '../socle/Trait.astro';
import liste from '../../content/interventions/liste.json';
import { tel, lienTel, lienWhatsApp } from '../../lib/garage';

/**
 * Préparer sa demande de devis.
 *
 * ⚠️ Ce bloc était un ESTIMATEUR DE PRIX. Le client n'ayant communiqué aucun
 * tarif, tout montant a été retiré : un prix inventé engage le garage. La
 * mécanique de conversion est conservée — on coche, on envoie — mais ce qui
 * part est une DEMANDE, pas une estimation.
 *
 * Entièrement côté client, aucune requête réseau. Sans JavaScript, la liste
 * reste lisible et le numéro est là : c'est pour ça qu'elle est dans le HTML
 * dès le départ et que le script ne fait que l'enrichir.
 */
const { gabarits, interventions } = liste;
---
<section class="section border-t border-gris-trait" id="devis" aria-labelledby="titre-devis">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2 id="titre-devis" class="text-[length:var(--text-2xl)] font-extrabold">
      Préparez votre passage
    </h2>
    <p class="mt-4 max-w-[54ch] text-lg text-gris-texte">
      Cochez ce que vous pensez avoir à faire. On vous rappelle avec un devis,
      gratuit et sans engagement — et on vous dit aussi ce qui n'est pas à changer.
    </p>

    <div class="mt-10 grid gap-px bg-gris-trait lg:grid-cols-[1.1fr_1fr]" data-devis>
      <!-- ── Le choix ── -->
      <div class="bg-blanc-atelier p-7 lg:p-9">
        <fieldset>
          <legend class="font-mono text-xs tracking-widest text-gris-texte uppercase">Votre véhicule</legend>
          <div class="mt-4 grid grid-cols-3 gap-3">
            {gabarits.map((g, i) => (
              <label class="choix cadre flex min-h-[44px] cursor-pointer flex-col justify-center p-3 text-center">
                <input type="radio" name="gabarit" value={g.libelle} checked={i === 0} class="sr-only" autocomplete="off" />
                <span class="text-sm font-semibold">{g.libelle}</span>
                <span class="mt-0.5 text-xs text-gris-texte">{g.exemples}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="mt-8">
          <legend class="font-mono text-xs tracking-widest text-gris-texte uppercase">Ce qu'il faut regarder</legend>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {interventions.map((it) => (
              <li>
                <label class="choix flex min-h-[44px] cursor-pointer items-center gap-3 p-2">
                  <input type="checkbox" name="intervention" value={it.libelle} class="sr-only" autocomplete="off" />
                  <span class="case cadre grid size-5 shrink-0 place-items-center" aria-hidden="true">
                    <Trait nom="coche" class="size-3.5 opacity-0" />
                  </span>
                  <span class="text-sm">{it.libelle}</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      </div>

      <!-- ── Le bon d'atelier ── -->
      <div class="bg-blanc-atelier p-7 lg:p-9">
        <div class="cadre relative p-6">
          <p class="font-mono text-[0.65rem] tracking-widest text-gris-texte uppercase">Bon d'atelier — brouillon</p>
          <p class="mt-3 font-display text-lg font-bold" data-gabarit>Citadine</p>
          <ul class="mt-4 min-h-[9rem] space-y-1.5 text-sm" data-recap>
            <li class="text-gris-texte">Rien de coché pour l'instant.</li>
          </ul>
          <p class="mt-4 border-t border-gris-trait pt-3 font-mono text-xs text-gris-texte">
            <span data-nombre>0</span> point(s) à vérifier
          </p>
        </div>

        <p class="mt-5 text-sm text-gris-texte">
          Ce bon n'est pas un devis : c'est ce dont on parlera au téléphone.
          <strong class="font-semibold text-encre">Le devis est gratuit et sans engagement.</strong>
        </p>

        <div class="mt-6 flex flex-col gap-3">
          <a href={lienWhatsApp('Bonjour, je voudrais un devis.')} data-whatsapp
             data-event="whatsapp" data-contexte="devis"
             class="flex min-h-[44px] cliquet items-center justify-center gap-2.5 px-6 py-4 font-semibold cadre transition-colors hover:bg-encre hover:text-blanc-atelier">
            <Trait nom="whatsapp" class="size-4" />
            Envoyer par WhatsApp
          </a>
          <a href={lienTel(tel.numero)} data-event="appel" data-contexte="devis"
             class="flex min-h-[44px] cliquet items-center justify-center gap-2.5 bg-turquoise px-6 py-4 font-semibold text-white transition-colors hover:bg-encre">
            <Trait nom="telephone" class="size-4" />
            <span class="chiffres whitespace-nowrap">{tel.affiche}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .choix { transition: background-color var(--duree-cliquet) var(--ease-cliquet); }
  .choix:hover { background-color: color-mix(in srgb, var(--color-gris-trait) 16%, transparent); }
  .choix:has(input:checked) { border-color: var(--color-encre); }
  .choix:has(input:checked) .case { border-color: var(--color-encre); background: var(--color-encre); color: var(--color-blanc-atelier); }
  .choix:has(input:checked) .case svg { opacity: 1; }
  /* ⚠️ Focus instantané, visible sur les deux fonds. Jamais de steps() ici. */
  .choix:has(input:focus-visible) {
    box-shadow: 0 0 0 2px var(--color-blanc-atelier), 0 0 0 4px var(--color-encre);
  }
  [data-recap] li { animation: pose 160ms steps(3, end) both; }
  @keyframes pose { from { transform: translateX(-6px); opacity: 0 } to { transform: none; opacity: 1 } }
  @media (prefers-reduced-motion: reduce) { [data-recap] li { animation: none } }
</style>

<script>
  const bloc = document.querySelector<HTMLElement>('[data-devis]');
  if (bloc) {
    const recap = bloc.querySelector<HTMLElement>('[data-recap]')!;
    const nombre = bloc.querySelector<HTMLElement>('[data-nombre]')!;
    const gabaritSortie = bloc.querySelector<HTMLElement>('[data-gabarit]')!;
    const versWhatsApp = bloc.querySelector<HTMLAnchorElement>('[data-whatsapp]')!;

    function mettreAJour() {
      const gabarit = bloc!.querySelector<HTMLInputElement>('input[name="gabarit"]:checked')?.value ?? '';
      const cochees = [...bloc!.querySelectorAll<HTMLInputElement>('input[name="intervention"]:checked')]
        .map((c) => c.value);

      gabaritSortie.textContent = gabarit;
      nombre.textContent = String(cochees.length);
      recap.innerHTML = cochees.length
        ? cochees.map((l) => `<li>· ${l}</li>`).join('')
        : '<li class="text-gris-texte">Rien de coché pour l\'instant.</li>';

      const message =
        `Bonjour, je voudrais un devis.\n\nVéhicule : ${gabarit}\n` +
        (cochees.length ? cochees.map((l) => `• ${l}`).join('\n') : '(à préciser au téléphone)');
      versWhatsApp.href = versWhatsApp.href.split('?')[0] + '?text=' + encodeURIComponent(message);
    }

    bloc.addEventListener('change', mettreAJour);
    mettreAJour();
  }
</script>
