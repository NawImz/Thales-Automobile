---
import Compteur from '../socle/Compteur.astro';
import bareme from '../../content/tarifs/bareme.json';
import { garage } from '../../lib/garage';

/**
 * ⚠️ Pas d'icônes ici, et c'est délibéré.
 * « Trois blocs avec une icône, un titre, une phrase » est le motif le plus
 * générique du web — je l'aurais écrit à l'identique pour un plombier. Les
 * trois raisons sont donc composées en typographie seule, et la raison n°2
 * porte un VRAI prix tiré du barème : la preuve est le contenu, pas une
 * illustration.
 */
const vidange = bareme.interventions.find((i) => i.id === 'vidange')!;
---
<section class="section border-t border-gris-trait" aria-labelledby="raisons">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <h2 id="raisons" class="sr-only">Pourquoi Thalès Automobile</h2>

    <div class="grid gap-px bg-gris-trait lg:grid-cols-3">
      <div class="bg-blanc-atelier p-8 lg:p-10">
        <p class="font-display text-2xl font-extrabold">On appelle<br />avant.</p>
        <p class="mt-4 text-gris-texte">
          Aucune intervention n'est engagée sans vous avoir eu au téléphone.
          Si on trouve autre chose en démontant, vous décidez.
        </p>
      </div>

      <div class="bg-blanc-atelier p-8 lg:p-10">
        <p class="font-display text-2xl font-extrabold">Les prix sont<br />affichés.</p>
        <p class="mt-4 text-gris-texte">
          Une vidange démarre à
          <span class="whitespace-nowrap font-semibold text-encre">
            <Compteur valeur={vidange.base} /> €</span>.
          Toute la grille est publique.
        </p>
        <a href="/tarifs" class="lien-trait cible mt-5 inline-flex items-center gap-2 text-sm font-semibold text-turquoise">
          Voir la grille complète
        </a>
      </div>

      <div class="bg-blanc-atelier p-8 lg:p-10">
        <p class="font-display text-2xl font-extrabold">Ce qui roule,<br />ce qui flotte.</p>
        <p class="mt-4 text-gris-texte">
          Voitures, hors-bord, in-board et jet-skis, dans le même atelier depuis
          <Compteur valeur={garage.anneesExperience} /> ans.
          Presque personne ne fait les deux en Île-de-France.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Soulignement au cliquet, origine gauche — le même geste que la nav. */
  .lien-trait { position: relative; padding-bottom: 2px; }
  .lien-trait::after {
    content: ''; position: absolute; left: 0; bottom: 0;
    width: 100%; height: var(--trait);
    background: currentColor;
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--duree-cliquet) var(--ease-cliquet);
  }
  .lien-trait:hover::after, .lien-trait:focus-visible::after { transform: scaleX(1); }
</style>
