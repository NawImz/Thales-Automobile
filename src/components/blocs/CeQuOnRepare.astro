---
import { lien } from '../../lib/garage';
import { getCollection } from 'astro:content';
import Trait from '../socle/Trait.astro';

const services = (await getCollection('services'))
  .sort((x, y) => x.data.ordre - y.data.ordre)
  .slice(0, 6);
---
<section class="section border-t border-gris-trait" id="reparer" aria-labelledby="titre-reparer">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 data-apparition id="titre-reparer" class="text-[length:var(--text-2xl)] font-extrabold">
        Ce qu'on répare
      </h2>
      <a href={lien('/#venir')} class="lien-trait cible inline-flex items-center gap-2 text-sm font-semibold">
        Demander un devis
        <Trait nom="fleche" class="size-4" />
      </a>
    </div>

    <ul class="grille-trait mt-10 grid sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <li data-apparition class="carte group relative p-7">
          <Trait nom={s.data.trait} class="size-7 text-encre" />
          <h3 class="mt-5 font-display text-lg font-bold">{s.data.titre}</h3>
          <p class="mt-2 text-sm text-gris-texte">{s.data.phrase}</p>
          <!-- Le cadre qui se resserre d'un cran au survol : pas d'ombre,
               pas d'élévation, pas d'agrandissement. -->
          <span class="cadre-cran" aria-hidden="true"></span>
        </li>
      ))}
    </ul>

    <p class="mt-8 max-w-none text-sm text-gris-texte">
      Le devis est gratuit et sans engagement. On vous appelle avant toute
      intervention qui n'y figure pas.
    </p>
  </div>
</section>

<style>
  .carte { isolation: isolate; }

  .cadre-cran {
    position: absolute;
    inset: 0;
    border: var(--trait) solid transparent;
    transition:
      inset var(--duree-cliquet) var(--ease-cliquet),
      border-color var(--duree-cliquet) var(--ease-cliquet);
    pointer-events: none;
  }
  .carte:hover .cadre-cran,
  .carte:focus-within .cadre-cran {
    inset: 8px;
    border-color: var(--color-encre);
  }

  .lien-trait { position: relative; padding-bottom: 2px; }
  .lien-trait::after {
    content: ''; position: absolute; left: 0; bottom: 0;
    width: 100%; height: var(--trait);
    background: currentColor;
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--duree-cliquet) var(--ease-cliquet);
  }
  .lien-trait:hover::after, .lien-trait:focus-visible::after { transform: scaleX(1); }
</style>
