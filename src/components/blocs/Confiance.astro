---
import { getCollection } from 'astro:content';
import Etoiles from '../socle/Etoiles.astro';
import Compteur from '../socle/Compteur.astro';
import Cliche from '../socle/Cliche.astro';
import { garage } from '../../lib/garage';

/**
 * ⚠️ Le brief demande quatre avis. Je n'en ai que TROIS de réels.
 * Aucun quatrième n'est inventé, et la grille est dimensionnée pour trois.
 * Le jour où Nabil en fournit d'autres, ils s'ajoutent au JSON, sans toucher
 * au code.
 */
const avis = (await getCollection('avis')).sort((x, y) => x.data.ordre - y.data.ordre);
const note = garage.avisGoogle.note.toString().replace('.', ',');
---
<section class="section border-t border-gris-trait" id="confiance" aria-labelledby="titre-confiance">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="lg:grid lg:grid-cols-[1fr_1.3fr] lg:items-start lg:gap-16">
      <div>
        <h2 id="titre-confiance" class="text-[length:var(--text-2xl)] font-extrabold">
          Pourquoi on nous<br />fait confiance
        </h2>
        <p class="mt-5 text-gris-texte">
          Nabil Bendjeddou tient l'atelier de la rue du Port depuis&nbsp;<Compteur valeur={garage.anneesExperience} />&nbsp;ans. La plupart des
          clients qui écrivent parlent de la même chose : on leur a dit ce qui
          n'était pas à changer.
        </p>

        <!-- La note est ATTRIBUÉE à Google et n'est pas balisée en
             aggregateRating : on ne balise pas des avis qu'on n'a pas
             collectés soi-même. -->
        <div class="mt-8 flex items-center gap-4 cadre p-5">
          <Etoiles note={garage.avisGoogle.note} class="text-2xl" />
          <p>
            <span class="chiffres text-2xl font-bold">{note}</span>
            <span class="text-gris-texte"> sur </span>
            <Compteur valeur={garage.avisGoogle.nombre} class="font-bold" />
            <span class="text-gris-texte"> avis</span><br />
            {garage.avisGoogle.url
              ? <a href={garage.avisGoogle.url} rel="noopener" class="cible text-sm text-turquoise">Voir la fiche Google</a>
              : <span class="text-sm text-gris-texte">sur Google <span class="font-mono text-xs">[LIEN À FOURNIR]</span></span>}
          </p>
        </div>

        <div class="mt-8">
          <Cliche nom="Nabil au travail dans l'atelier" ratio="3 / 2" />
        </div>
      </div>

      <ul class="grille-trait mt-12 grid lg:mt-0">
        {avis.map((a) => (
          <li class="p-7">
            <blockquote>
              <p class="text-lg">« {a.data.extrait} »</p>
            </blockquote>
            <p class="mt-4 flex flex-wrap items-baseline gap-x-3 text-sm">
              <span class="font-semibold">{a.data.auteur}</span>
              <span class="font-mono text-xs text-gris-texte">{a.data.profil}</span>
            </p>
            {a.data.ancienneteDite && (
              <p class="mt-1 text-sm font-semibold">{a.data.ancienneteDite}</p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
