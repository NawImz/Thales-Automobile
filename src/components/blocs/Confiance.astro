---
import { getCollection } from 'astro:content';
import Etoiles from '../socle/Etoiles.astro';
import Trait from '../socle/Trait.astro';
import Compteur from '../socle/Compteur.astro';
import { garage } from '../../lib/garage';

/**
 * ⚠️ Le brief demande quatre avis. Je n'en ai que TROIS de réels, et aucun
 * quatrième n'est inventé. La grille est dimensionnée pour trois.
 */
const avis = (await getCollection('avis')).sort((x, y) => x.data.ordre - y.data.ordre);
const note = garage.avisGoogle.note.toString().replace('.', ',');
---
<section class="section border-t border-gris-trait" id="confiance" aria-labelledby="titre-confiance">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="lg:grid lg:grid-cols-[1fr_1.3fr] lg:items-start lg:gap-16">
      <div>
        <h2 data-apparition id="titre-confiance" class="text-[length:var(--text-2xl)] font-extrabold">
          Pourquoi on nous<br />fait confiance
        </h2>
        <p class="mt-5 text-gris-texte">
          Nabil Bendjeddou tient l'atelier de la rue du Port depuis&nbsp;<Compteur valeur={garage.anneesExperience} />&nbsp;ans. La plupart des
          clients qui écrivent parlent de la même chose : on leur a dit ce qui
          n'était pas à changer.
        </p>

        <!-- La note est ATTRIBUÉE à Google et n'est pas balisée en
             aggregateRating : on ne balise pas des avis qu'on n'a pas
             collectés soi-même. -->
        <!-- ⚠️ En colonne sous `sm` : à 390 px, les étoiles en text-2xl et la
             ligne « 4,6 sur 61 avis » côte à côte se disloquaient, le lien
             passant à la ligne mot par mot. Mesuré à l'écran, pas supposé. -->
        <div data-apparition="cadre" class="mt-8 flex flex-col items-start gap-3 cadre p-5 sm:flex-row sm:items-center sm:gap-5">
          <Etoiles note={garage.avisGoogle.note} class="text-lg sm:text-2xl" />
          <p>
            <span class="chiffres text-2xl font-bold">{note}</span>
            <span class="text-gris-texte"> sur </span>
            <Compteur valeur={garage.avisGoogle.nombre} class="font-bold" />
            <span class="text-gris-texte"> avis</span><br />
            {garage.avisGoogle.url
              ? <a
                  href={garage.avisGoogle.url}
                  target="_blank" rel="noopener noreferrer"
                  data-event="avis-google" data-contexte="confiance"
                  class="lien-avis cible mt-1 inline-flex items-center gap-1.5 text-sm font-semibold text-turquoise"
                >
                  Lire les avis sur Google
                  <Trait nom="fleche" class="size-3.5" />
                </a>
              : <span class="block text-sm text-gris-texte">sur Google <span class="font-mono text-xs">[LIEN À FOURNIR]</span></span>}
          </p>
        </div>

      </div>

      <ul class="grille-trait mt-12 grid lg:mt-0">
        {avis.map((a) => (
          <li data-apparition class="p-7">
            <blockquote>
              <p class="text-lg">« {a.data.extrait} »</p>
            </blockquote>
            <p class="mt-4 flex flex-wrap items-baseline gap-x-3 text-sm">
              <span class="font-semibold">{a.data.auteur}</span>
              {/* Sonia A. n'a pas la qualité « Local Guide » : son profil est
                  vide, et un <span> vide laisserait une gouttière orpheline. */}
              {a.data.profil && (
                <span class="font-mono text-xs text-gris-texte">{a.data.profil}</span>
              )}
            </p>
            {a.data.ancienneteDite && (
              <p class="mt-1 text-sm font-semibold">{a.data.ancienneteDite}</p>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .lien-avis { position: relative; padding-bottom: 2px; }
  .lien-avis::after {
    content: ''; position: absolute; left: 0; bottom: 0;
    width: 100%; height: var(--trait);
    background: currentColor;
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--duree-cliquet) var(--ease-cliquet);
  }
  .lien-avis:hover::after, .lien-avis:focus-visible::after { transform: scaleX(1); }
</style>
