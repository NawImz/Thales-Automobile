---
/**
 * Icônes lucide-static.
 * ⚠️ Piège coûteux : les SVG lucide ont des attributs sur plusieurs lignes.
 * Un raw.replace('<svg ', …) échoue SILENCIEUSEMENT — aucune classe appliquée,
 * toutes les tailles/couleurs cassées, zéro erreur console.
 * Seule forme fiable : remplacer l'attribut class existant par regex.
 */
interface Props {
  name: string;
  class?: string;
  'aria-label'?: string;
}
const { name, class: className = 'w-5 h-5', ...rest } = Astro.props;

const icons = import.meta.glob('/node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const raw = icons[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Icône lucide introuvable : « ${name} »`);

const svg = raw.replace(/class="[^"]*"/, `class="${className}"`);
const decorative = !rest['aria-label'];
---

<span
  class="contents"
  aria-hidden={decorative ? 'true' : undefined}
  aria-label={rest['aria-label']}
  role={decorative ? undefined : 'img'}
  set:html={svg}
/>
