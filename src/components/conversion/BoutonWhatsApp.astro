---
import { lienWhatsApp } from '../../lib/garage';
import Icone from '../socle/Icone.astro';

interface Props {
  message: string;
  libelle?: string;
  variante?: 'plein' | 'contour';
  class?: string;
  contexte?: string;
}
const {
  message,
  libelle = 'Écrire sur WhatsApp',
  variante = 'contour',
  class: classe = '',
  contexte = 'generique',
} = Astro.props;

const styles = {
  plein: 'bg-rouge-yamaha text-white hover:bg-[#a80d26]',
  contour: 'border border-cambouis text-cambouis hover:bg-cambouis hover:text-tole',
};
---
<a
  href={lienWhatsApp(message)}
  data-event="whatsapp"
  data-contexte={contexte}
  rel="noopener"
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-[2px] px-5 py-3',
    'text-base font-semibold transition-colors',
    styles[variante],
    classe,
  ]}
>
  <Icone nom="message" class="size-5 shrink-0" />
  <span>{libelle}</span>
</a>
