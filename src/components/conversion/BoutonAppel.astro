---
import { garage, lienTel } from '../../lib/garage';
import Icone from '../socle/Icone.astro';

interface Props {
  ligne?: 'principal' | 'fixe' | 'depannage';
  variante?: 'plein' | 'contour' | 'nu';
  class?: string;
  contexte?: string;
}
const { ligne = 'principal', variante = 'contour', class: classe = '', contexte = 'generique' } = Astro.props;
const tel = garage.telephones[ligne];

const styles = {
  plein: 'bg-rouge-yamaha text-white hover:bg-[#a80d26]',
  contour: 'border border-cambouis text-cambouis hover:bg-cambouis hover:text-tole',
  nu: 'text-cambouis hover:text-rouge-yamaha',
};
---
<a
  href={lienTel(tel.numero)}
  data-event="appel"
  data-contexte={contexte}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-[2px] px-5 py-3',
    'font-mono text-base font-semibold whitespace-nowrap transition-colors',
    styles[variante],
    classe,
  ]}
>
  <Icone nom="telephone" class="size-5 shrink-0" />
  <span>{tel.affiche}</span>
</a>
