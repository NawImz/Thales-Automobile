---
import Base from '../layouts/Base.astro';
import { garage, a, tel } from '../lib/garage';
const l = garage.legal;
/** Affiche la valeur si elle existe, sinon un placeholder VISIBLE. On ne
    remplit jamais une mention légale avec une valeur inventée. */
const ou = (v: string | null, quoi: string) => v ?? `[À COMPLÉTER — ${quoi}]`;
---
<Base titre={`Mentions légales — ${garage.nom}`} description="Mentions légales du garage Thalès Automobile.">
  <section class="section">
    <div class="prose mx-auto max-w-3xl px-5 sm:px-8">
      <h1 class="text-[length:var(--text-2xl)] font-extrabold">Mentions légales</h1>

      <div class="mt-8 cadre bg-blanc-atelier p-5 text-sm">
        <p class="font-semibold">⚠️ Page incomplète — ne pas mettre en ligne en l'état.</p>
        <p class="mt-2 text-gris-texte">
          Les informations manquantes sont obligatoires. Le médiateur de la
          consommation en particulier (art. L.612-1 du code de la consommation)
          est requis pour tout professionnel vendant à des particuliers.
        </p>
      </div>

      <h2 class="mt-10 font-display text-lg font-bold">Éditeur du site</h2>
      <dl class="mt-4 space-y-2 text-sm">
        <div><dt class="inline font-semibold">Raison sociale : </dt><dd class="inline">{garage.nom}</dd></div>
        <div><dt class="inline font-semibold">Forme juridique : </dt><dd class="inline">{ou(l.formeJuridique, 'SARL, EI, auto-entrepreneur…')}</dd></div>
        <div><dt class="inline font-semibold">SIRET : </dt><dd class="inline">{ou(l.siret, 'numéro SIRET')}</dd></div>
        <div><dt class="inline font-semibold">TVA intracommunautaire : </dt><dd class="inline">{ou(l.tvaIntracom, 'numéro de TVA, ou mention art. 293 B du CGI')}</dd></div>
        <div><dt class="inline font-semibold">Siège : </dt><dd class="inline">{a.rue}, {a.codePostal} {a.ville}</dd></div>
        <div><dt class="inline font-semibold">Téléphone : </dt><dd class="inline chiffres">{tel.affiche}</dd></div>
        <div><dt class="inline font-semibold">E-mail : </dt><dd class="inline">{ou(garage.email, 'adresse professionnelle')}</dd></div>
        <div><dt class="inline font-semibold">Directeur de la publication : </dt><dd class="inline">{ou(l.directeurPublication, 'nom du responsable')}</dd></div>
      </dl>

      <h2 class="mt-10 font-display text-lg font-bold">Assurance professionnelle</h2>
      <p class="mt-3 text-sm">{ou(l.assuranceRcPro, 'assureur, numéro de contrat, couverture géographique')}</p>

      <h2 class="mt-10 font-display text-lg font-bold">Médiateur de la consommation</h2>
      <p class="mt-3 text-sm">
        {ou(l.mediateurConsommation, 'nom et coordonnées du médiateur — OBLIGATOIRE')}
      </p>

      <h2 class="mt-10 font-display text-lg font-bold">Hébergement</h2>
      <p class="mt-3 text-sm">[À COMPLÉTER — hébergeur retenu, raison sociale et adresse]</p>

      <h2 class="mt-10 font-display text-lg font-bold">Propriété intellectuelle</h2>
      <p class="mt-3 text-sm">
        L'ensemble des contenus de ce site (textes, photographies, logo) est la
        propriété de {garage.nom}, sauf mention contraire. Toute reproduction
        sans autorisation est interdite.
      </p>
    </div>
  </section>
</Base>
