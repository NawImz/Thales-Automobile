---
import Base from '../layouts/Base.astro';
import Hero from '../components/blocs/Hero.astro';
import TroisRaisons from '../components/blocs/TroisRaisons.astro';
import CeQuOnRepare from '../components/blocs/CeQuOnRepare.astro';
import Estimateur from '../components/blocs/Estimateur.astro';
import AutoEtBateau from '../components/blocs/AutoEtBateau.astro';
import Confiance from '../components/blocs/Confiance.astro';
import Venir from '../components/blocs/Venir.astro';
import { garage, a } from '../lib/garage';

const titre = `Garage auto et bateaux à ${a.ville} — ${garage.nom}`;
const description =
  `Réparation auto, hors-bord et jet-ski à ${a.ville}. Prix affichés, devis gratuit. ` +
  `${garage.anneesExperience} ans d'atelier, ouvert du lundi au samedi.`;
---
<Base titre={titre} description={description}>
  <Hero />
  <TroisRaisons />
  <CeQuOnRepare />
  <Estimateur />
  <AutoEtBateau />
  <Confiance />
  <Venir />
</Base>
