---
import '../styles/global.css';
import EnTete from '../components/socle/EnTete.astro';
import PiedDePage from '../components/socle/PiedDePage.astro';
import BarreAction from '../components/socle/BarreAction.astro';
import Decor from '../components/signature/Decor.astro';
import Apparition from '../components/socle/Apparition.astro';
import { garage, a, tel } from '../lib/garage';

interface Props { titre: string; description: string; }
const { titre, description } = Astro.props;
const canonique = new URL(Astro.url.pathname, Astro.site).href;

/**
 * JSON-LD AutoRepair.
 * ⚠️ PAS d'aggregateRating : Google interdit de baliser des avis qu'on n'a pas
 * collectés soi-même — motif de sanction manuelle. La note 4,6 s'affiche
 * visuellement, attribuée à Google, et rien de plus.
 */
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: garage.nom,
  description,
  url: canonique,
  telephone: '+33' + tel.numero.replace(/^0/, ''),
  address: {
    '@type': 'PostalAddress',
    streetAddress: a.rue,
    postalCode: a.codePostal,
    addressLocality: a.ville,
    addressCountry: a.pays,
  },
  priceRange: garage.gammePrix,
  paymentAccepted: garage.paiement.join(', '),
  areaServed: garage.zonesDesservies.map((v) => ({ '@type': 'City', name: v })),
  openingHoursSpecification: garage.horaires
    .filter((h) => h.ouvre)
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][h.jour],
      opens: h.ouvre,
      closes: h.ferme,
    })),
};
// Les coordonnées ne sont ajoutées que si elles existent : pas de geo inventé.
if (garage.geo.latitude !== null && garage.geo.longitude !== null) {
  jsonLd.geo = {
    '@type': 'GeoCoordinates',
    latitude: garage.geo.latitude,
    longitude: garage.geo.longitude,
  };
}
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta name="theme-color" content="#0E7C7C" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenu" class="evitement">Aller au contenu</a>
    <EnTete />
    <Decor />
    <Apparition />
    <main id="contenu"><slot /></main>
    <PiedDePage />
    <BarreAction />
  </body>
</html>
